{
  "name": "agent-m42-slack-cockpit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Private read-only Slack App Home cockpit for the M42 portfolio (decoupled sidecar).",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
